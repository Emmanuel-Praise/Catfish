# ---- LLM ----
# NVIDIA API (build.nvidia.com) — primary when set
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_SECONDS=40

# OpenAI-compatible fallback (used only when NVIDIA_* are unset)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional fallbacks (comma-separated) tried if the primary fails or returns empty
LLM_FALLBACK_MODEL=openrouter/free, baidu/ernie-5.5-flash-preview:free

# ---- App ----
DATABASE_PATH=kile.db
HOST=127.0.0.1
PORT=8000

# ---- Proactive messages ----
PROACTIVE_QUIET_START=22
PROACTIVE_QUIET_END=08
PROACTIVE_COOLDOWN_HOURS=12

# ---- Reply pacing (seconds; never instant, never too long) ----
REPLY_DELAY_MIN=3
REPLY_DELAY_MAX=9

# ---- WhatsApp / Meta Cloud API ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# Message delivery: "log" (simulator only) or "whatsapp" (real delivery)
MESSAGE_CHANNEL=log
